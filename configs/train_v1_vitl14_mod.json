         "MVSynth": 10,
         "NeRDS360": 10,
         "NianticMapFree": 10,
         "PointOdyssey": 10,
         "ScanNet": 10,
         "ScanNetpp": 10,
         "Sintel": 10,
         "TartanAir": 10,
         "TATRMVD": 10,
         "Theo": 10,
         "UnrealStereo4K": 10,
         "Waymo": 10,
         "WildRGBD": 10,
         // Image datasets from UniDepth
         "DDAD": 1,
         "DiodeIndoor": 1,
         "HAMMER": 1,
         "IBims": 1,
         "KITTI": 1,
         "Nuscenes": 1,
         "NYUv2Depth": 1,
         "SUNRGBD": 1,
         "VOID": 1,
         "ETH3D": 1,
       },
       "train_datasets":[
         // Sequence datasets from UniDepth
         "Argoverse2",        // Used in validation (train/test)
         "ScanNet",           // Used in validation (train/test)
         "Waymo",             // Used in validation (train/test)
         // Available sequence datasets
