services:
  unidepth:
    build:
      context: .
      dockerfile: Dockerfile
      args:
        TORCH_CUDA_ARCH_LIST: 8.6
        USER_UID: 1000
        USER_GID: 1000
        
    ports:
      - "43800:43800"
    volumes:
      - <DATA_FOLDER>:/data
      - <DATASETS_FOLDER>:/data/datasets
    environment:
      DATA: /data
      DATASETS: /data/datasets
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]
      